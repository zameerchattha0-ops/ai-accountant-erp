# =============================================================================
# ERP AI Agent — Git ignore rules
# =============================================================================

# ---- Secrets (NEVER commit) ----
.env
.env.*
!.env.example

# ---- Local credential drops (NEVER commit) ----
# A token pasted into a file by hand, e.g. `github.txt` (Windows Explorer
# "New text document" produces `github.txt.txt`).  These were previously NOT
# ignored, so a routine `git add .` would have committed a live PAT.
# `*token*.txt` also covers hand-saved provider tokens.
github.txt
github.txt.txt
*token*.txt
*Token*.txt
*tokens*.txt
*secret*.txt
*secrets*.txt
*credential*.txt
*credentials*.txt
# Hand-dropped Supabase PAT for scripts/apply_migrations.py rotation
# (the runner reads it as the highest-priority token source).
Supabase.txt

# ---- Vercel ----
.vercel/

# ---- Python virtual environments ----
venv/
env/
.venv/

# ---- Python artifacts ----
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# ---- Node / Next.js ----
node_modules/
.next/
out/
coverage/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- Generated diagnostics & run logs (local debugging leftovers) ----
runapp_log.txt
runapp_test_out.txt
backend.log
frontend.log
dir_grep*.txt
stepmap.txt
syn.txt
sync.txt
pb.txt
pil_ok.txt
r2_*.txt
r3_*.txt
r4_*.txt
reg2_*.txt
reg3_*.txt
reasoning_*.txt
# Local verification output
build*.txt
tsc*.txt
scripts/test_invoice.png

# ---- OS / IDE ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/

# ---- Any local log files ----
*.log

# ---- Local scratch ----
scripts/test_*.py
scripts/smoke_test.py
.env.local
*.png.tmp

# ---- Session artifacts (local runtime state — NEVER commit) ----
aes_session_ids.json

# ---- Live-E2E runner scratch (regenerated on every run) ----
_e2e_out.txt
_e2e_exit.txt
_e2e_run.ps1


# ---- Live-verification runner scratch (regenerated per run) ----
_lc_out.txt
_lc_exit.txt
_lc_run.ps1
_worker_out.txt
_worker_run.ps1
